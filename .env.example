APP_NAME="Nexolu POS API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pos_saas
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Credencial simetrica compartida con el servicio Nexolu IA Core (repo Python
# aparte): el IA Core la presenta para invocar POST /api/ai/tools/invoke, y
# este POS la presenta para invocar POST {IA_CORE_BASE_URL}/v1/chat. Debe
# coincidir con NEXOLU_APPS_JSON.pos.api_key del lado del IA Core.
IA_CORE_API_KEY=
IA_CORE_BASE_URL=http://localhost:8000

# Nexolu Payments Core (repo Python aparte, pasarela de pagos unificada).
# PAYMENTS_CORE_API_KEY es la que este POS presenta al llamar
# POST {PAYMENTS_CORE_BASE_URL}/v1/payments/intents (se registra del lado
# del Core via scripts/register_integration.py). PAYMENTS_CORE_WEBHOOK_SECRET
# verifica la firma X-Nexolu-Signature de los webhooks entrantes del Core -
# ver PaymentsCoreWebhookController.
PAYMENTS_CORE_API_KEY=
PAYMENTS_CORE_BASE_URL=http://localhost:8001
PAYMENTS_CORE_WEBHOOK_SECRET=

# Nexolu Communications (repo Python aparte, envio centralizado de
# WhatsApp/email). MESSAGING_DRIVER decide quien envia el WhatsApp saliente
# hoy: 'whatsapp_direct' (Meta directo, valor por defecto, sin cambios de
# comportamiento) o 'nexolu_comms' (via este servicio) - ver
# AppServiceProvider. COMMS_CORE_API_KEY es la que este POS presenta al
# llamar POST {COMMS_CORE_BASE_URL}/v1/notifications/send (se registra del
# lado de Comms via NEXOLU_APPS_JSON.pos.api_key). COMMS_CORE_WEBHOOK_SECRET
# verifica la firma X-Nexolu-Signature de los eventos entrantes que Comms
# reenvia - ver NexoluCommsWebhookController. Debe coincidir con
# NEXOLU_APPS_JSON.pos.whatsapp.callback_secret del lado de Comms.
MESSAGING_DRIVER=whatsapp_direct
COMMS_CORE_API_KEY=
COMMS_CORE_BASE_URL=http://localhost:8010
COMMS_CORE_WEBHOOK_SECRET=

# WhatsApp Cloud API (asistente IA omnichannel). verify_token valida el
# webhook (GET) al configurarlo en Meta; access_token/phone_number_id son
# para ENVIAR (Graph API), se generan en Meta (System User, idealmente
# permanente). Las plantillas NO van aqui - viven hardcodeadas en
# config/services.php (whatsapp.templates), no son secretos. Cuando
# MESSAGING_DRIVER=nexolu_comms, estas credenciales dejan de usarse para
# ENVIAR (Comms tiene las suyas propias) pero verify_token sigue siendo
# necesario mientras el webhook siga apuntando aca en vez de a Comms.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0
