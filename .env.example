APP_NAME="Nexolu POS API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173
# Colombia no tiene horario de verano - offset fijo. Ver config/app.php y
# config/database.php (DB_TIMEZONE, timezone de sesion MySQL).
APP_TIMEZONE=America/Bogota
DB_TIMEZONE=-05:00

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pos_saas
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Disco donde se guardan las fotos de producto (ver ProductImageService).
# En local: `public` + `php artisan storage:link`. En produccion: `s3`,
# apuntando a DigitalOcean Spaces con las AWS_* de mas abajo (Spaces es
# compatible con S3; AWS_ENDPOINT es lo que lo distingue de AWS real).
# Cambiarlo solo afecta a las fotos nuevas: cada fila de product_images
# recuerda en que disco se guardo.
PRODUCT_IMAGES_DISK=public

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# `comms` manda el correo por el Nexolu Communications Core (igual que el
# WhatsApp). `log` en local, `comms` en SG y produccion. Ver
# App\Mail\Transport\CommsTransport.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
SUPPORT_EMAIL=general@nexolu.co

# Para DigitalOcean Spaces: KEY/SECRET son las "Spaces access keys" (no las
# de la API de DO), REGION el slug del datacenter (ej. nyc3), ENDPOINT
# https://<region>.digitaloceanspaces.com y URL el dominio del CDN.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Credencial simetrica compartida con el servicio Nexolu IA Core (repo Python
# aparte): el IA Core la presenta para invocar POST /api/ai/tools/invoke, y
# este POS la presenta para invocar POST {IA_CORE_BASE_URL}/v1/chat. Debe
# coincidir con NEXOLU_APPS_JSON.pos.api_key del lado del IA Core.
IA_CORE_API_KEY=
IA_CORE_BASE_URL=http://localhost:8000

# API key de PLATAFORMA del IA Core (credencial distinta a IA_CORE_API_KEY,
# no es por-app): la usa AiPlatformUsageService para GET /v1/platform/usage,
# el costo real de IA que alimenta el dashboard de Finanzas del SuperAdmin.
IA_CORE_PLATFORM_API_KEY=

# Credencial simetrica compartida con pos-saas (monolito legacy): la usa
# para llamar POST /admin/businesses/{id}/run-migration-patches (boton
# "Correr parches" del superadmin, ver EnsureValidLegacyAdminKey). Debe
# coincidir con NEXOLU_POS_API_ADMIN_KEY del lado de pos-saas.
LEGACY_ADMIN_API_KEY=

# Nexolu Payments Core (repo Python aparte, pasarela de pagos unificada).
# PAYMENTS_CORE_API_KEY es la que este POS presenta al llamar
# POST {PAYMENTS_CORE_BASE_URL}/v1/payments/intents (la genera el Core al
# crear la Integration "nexolu-pos" via su API de provisioning interna,
# POST /v1/admin/merchants/{merchant_id}/integrations con
# X-Payments-Provisioning-Key - operacion manual/de infraestructura, no la
# corre este repo; en local, start_local_pos.sh la hace por vos la primera
# vez). PAYMENTS_CORE_WEBHOOK_SECRET verifica la firma X-Nexolu-Signature de
# los webhooks entrantes del Core - ver PaymentsCoreWebhookController.
# BASE_URL usa host.docker.internal, no localhost, porque el Core corre en
# el host y este POS en el contenedor Sail.
PAYMENTS_CORE_API_KEY=
PAYMENTS_CORE_BASE_URL=http://host.docker.internal:8003
PAYMENTS_CORE_WEBHOOK_SECRET=
# Llave administrativa del Payments Core: necesaria para que un negocio
# conecte su propia pasarela (Wompi o Bold). Sin ella, la tienda funciona
# pero no puede cobrar en linea.
PAYMENTS_CORE_PROVISIONING_KEY=

# Nexolu Communications (repo Python aparte, envio centralizado de
# WhatsApp/email). MESSAGING_DRIVER decide quien envia el WhatsApp saliente
# hoy: 'whatsapp_direct' (Meta directo, valor por defecto, sin cambios de
# comportamiento) o 'nexolu_comms' (via este servicio) - ver
# AppServiceProvider. COMMS_CORE_API_KEY es la que este POS presenta al
# llamar POST {COMMS_CORE_BASE_URL}/v1/notifications/send (se registra del
# lado de Comms via NEXOLU_APPS_JSON.pos.api_key). COMMS_CORE_WEBHOOK_SECRET
# verifica la firma X-Nexolu-Signature de los eventos entrantes que Comms
# reenvia - ver NexoluCommsWebhookController. Debe coincidir con
# NEXOLU_APPS_JSON.pos.whatsapp.callback_secret del lado de Comms.
MESSAGING_DRIVER=whatsapp_direct
COMMS_CORE_API_KEY=
COMMS_CORE_BASE_URL=http://localhost:8010
COMMS_CORE_WEBHOOK_SECRET=

# WhatsApp Cloud API (asistente IA omnichannel). verify_token valida el
# webhook (GET) al configurarlo en Meta; access_token/phone_number_id son
# para ENVIAR (Graph API), se generan en Meta (System User, idealmente
# permanente). Las plantillas NO van aqui - viven hardcodeadas en
# config/services.php (whatsapp.templates), no son secretos. Cuando
# MESSAGING_DRIVER=nexolu_comms, estas credenciales dejan de usarse para
# ENVIAR (Comms tiene las suyas propias) pero verify_token sigue siendo
# necesario mientras el webhook siga apuntando aca en vez de a Comms.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0

# Confirmacion al agendar + recordatorio 2h antes de una cita (ver
# AppointmentWhatsappNotifier) - vacio hasta que existan las plantillas
# reales, aprobadas en Meta, para estos dos mensajes.
WHATSAPP_TEMPLATE_CITA_CONFIRMACION=
WHATSAPP_TEMPLATE_CITA_RECORDATORIO=
# Tienda online. Van al comprador. Vacías = no se manda WhatsApp y se usa
# solo el correo; poner aquí el nombre de la plantilla una vez aprobada en Meta.
WHATSAPP_TEMPLATE_PEDIDO_RECIBIDO=
WHATSAPP_TEMPLATE_PEDIDO_CONFIRMADO=
WHATSAPP_TEMPLATE_PEDIDO_ENVIADO=

# --- Sentry (error tracking, optional) ---
# Dejar VACIO fuera de produccion. El ruido de local y SG se mezcla con los
# errores reales y vuelve inutil el panel, que es justo lo contrario de para
# lo que sirve.
#
# El backend ya lo blinda solo: config/sentry.php ignora el DSN si APP_ENV no
# esta en SENTRY_ENVIRONMENTS (por defecto 'production'). El FRONTEND no puede
# hacer lo mismo -- su DSN se congela al compilar -- asi que ahi la unica
# defensa es esta variable vacia (ver VITE_SENTRY_DSN_PUBLIC en
# nexolu-pos-front/.env.example).
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_ENVIRONMENTS=production

# Base publica de la tienda online (repo nexolu-store-front).
STOREFRONT_URL=http://localhost:5175
