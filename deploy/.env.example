# Variables de INFRAESTRUCTURA del droplet (MySQL, dominios) - copiar a
# deploy/.env y completar. Nunca commitear el .env real.
#
# Cada servicio (pos-api, ia-core, comms-api, payments-core) sigue teniendo
# su PROPIO .env real (copiado de su propio .env.example) en la raiz de su
# repo, exactamente igual que en desarrollo local - este archivo NO los
# reemplaza, docker-compose.yml los referencia via `env_file`.

MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=

POS_DOMAIN=pos.nexolu.co
COMMS_DOMAIN=comms.nexolu.co
PAYMENTS_DOMAIN=payments.nexolu.co
